
# Environment configuration for Ghost Labs
# Copy this to .env and fill in your values

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/ghostlabs

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Docker
DOCKER_SOCKET=/var/run/docker.sock
WORKSPACE_IMAGE=ubuntu:22.04
WORKSPACE_SNAPSHOT_PATH=/app/snapshots

# Cloudflare Tunnel (Optional - for production)
CLOUDFLARE_TUNNEL_TOKEN=

# AI Service
AI_SERVICE_URL=http://ai-service:8001
OPENAI_API_KEY=
MODEL_NAME=gpt-3.5-turbo

# Frontend
VITE_API_URL=http://localhost:8000

# Application
DEBUG=True
