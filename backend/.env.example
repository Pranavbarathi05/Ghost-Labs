# Environment variables for Ghost Labs Backend
# Copy this file to .env and update with your values

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/ghostlabs

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Docker
DOCKER_SOCKET=/var/run/docker.sock
WORKSPACE_IMAGE=ubuntu:22.04
WORKSPACE_SNAPSHOT_PATH=/app/snapshots

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token

# AI Service
AI_SERVICE_URL=http://ai-service:8001

# Application
DEBUG=True
